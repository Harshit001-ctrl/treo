# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=4000

# Standard Node environment flag. In production, the crawler's URL guard
# rejects private/loopback/link-local addresses. Leave as "development" for
# local work and for running the batch evaluate command against local fixture
# sites (the assessment brief explicitly allows localhost company sites there).
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas free tier, or a local mongod).
MONGODB_URI=mongodb://localhost:27017/prepkit

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# The frontend's origin, for CORS + cookie settings. In production this must
# be the deployed Vercel URL (exact scheme+host, no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API key (https://aistudio.google.com/apikey) — free tier.
GEMINI_API_KEY=

# Model name. gemini-flash-lite-latest is the default: it's a rolling alias
# (so it never 404s from a retired pinned version), and the "lite" tier is
# better-provisioned and faster than the newest frontier flash model, which
# matters here — this pipeline's structured-extraction calls don't need
# frontier reasoning, and the newest flash tier returned frequent 503 "high
# demand" errors in testing where flash-lite did not. Our retry/backoff in
# llm/rateLimiter.ts handles either kind of transient failure regardless of
# which model you point this at.
GEMINI_MODEL=gemini-flash-lite-latest
