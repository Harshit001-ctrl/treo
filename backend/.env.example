# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=4000

# Standard Node environment flag. In production, the crawler's URL guard
# rejects private/loopback/link-local addresses. Leave as "development" for
# local work and for running the batch evaluate command against local fixture
# sites (the assessment brief explicitly allows localhost company sites there).
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas free tier, or a local mongod).
MONGODB_URI=mongodb://localhost:27017/prepkit

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# The frontend's origin, for CORS + cookie settings. In production this must
# be the deployed Vercel URL (exact scheme+host, no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API key (https://aistudio.google.com/apikey) — free tier.
GEMINI_API_KEY=

# Model name. gemini-3.6-flash is the default: fast, cheap, supports strict
# JSON-schema structured output, and has a workable free-tier rate limit.
# Google renames/retires flash models periodically — if you get a 404 "model
# no longer available" error, check https://ai.google.dev/gemini-api/docs/models
# for the current flash model name and update this value.
GEMINI_MODEL=gemini-3.6-flash
